<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring/JPA beans, entities and DTO records intentionally expose framework-managed references. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Constructor validation in Spring services is acceptable; classes do not implement finalizers. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
