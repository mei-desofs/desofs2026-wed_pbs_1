# GhostReport local environment template.
# Copy to a local .env file or export these variables in the shell.
# Do not commit real secrets.

# Runtime profile.
# Use dev for local development, test for automated tests, and leave unset or use prod for production-like startup.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL connection.
DB_URL=jdbc:postgresql://localhost:5432/ghostreport
DB_USERNAME=postgres
DB_PASSWORD=change-this-local-password

# JWT signing secret.
# Must be at least 32 characters. Use a unique random value per environment.
JWT_SECRET=your-secret-key-here-minimum-32-characters-long
JWT_PREVIOUS_SECRETS=
JWT_EXPIRATION_SECONDS=3600

# Backup manifest HMAC signing key.
# Must be at least 32 characters and must be different from JWT_SECRET.
BACKUP_HMAC_SECRET=change-this-backup-hmac-secret-32-chars
BACKUP_HMAC_KEY_ID=local-backup-hmac-v1

# Optional development seed users.
# Only has effect in dev/test because the DataInitializer is profile-restricted.
GHOSTREPORT_SEED_USERS_ENABLED=true

# Upload abuse protection.
APP_UPLOAD_MAX_FILES_PER_REQUEST=5

# Optional rate limit overrides.
RATE_LIMIT_TRACKING_MAX_ATTEMPTS=10
RATE_LIMIT_TRACKING_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX_ATTEMPTS=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_DOWNLOAD_MAX_ATTEMPTS=10
RATE_LIMIT_DOWNLOAD_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
